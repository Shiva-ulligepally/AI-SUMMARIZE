# Example environment variables for SmartSumm
# Copy this file to `.env` for local development, and set real values in Vercel Dashboard for production.

PORT=5000
MONGO_URI=your-mongodb-connection-string
JWT_SECRET=your-jwt-secret
GEMINI_API_KEY=your-gemini-or-openai-key
GROQ_API=your-groq-api-key
NODE_ENV=production
CORS_ORIGIN=
