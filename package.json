{
  "name": "smartsumm-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": "20.x"
  },
  
  "scripts": {
    "build": "node build.js",
    "start": "node backend/src/index.js",
    "dev": "concurrently \"cd backend && npm run dev\" \"cd frontend && npm run dev\""
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "turbo": "^2.0.0"
  }
}
